<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>AdmiGo | Find Your Course & College</title>
<meta name="description" content="AdmiGo by Nitish Kumar — admission guidance for Nursing, Pharmacy, Paramedical, Engineering, Computer, Management, Commerce, ITI and more across India.">
<meta name="robots" content="index,follow">
<link rel="canonical" href="https://admigo.co.in/">
<style>
:root{--b:#2563eb;--g:#16a34a;--d:#0f172a;--m:#64748b;--bg:#f8fafc;--line:#e2e8f0}
*{box-sizing:border-box}html{scroll-behavior:smooth}body{margin:0;font-family:Arial,sans-serif;color:var(--d);background:var(--bg);line-height:1.55}
a{text-decoration:none}.wrap{width:min(1120px,92%);margin:auto}header{position:sticky;top:0;z-index:5;background:#fff;border-bottom:1px solid var(--line)}
.nav{height:68px;display:flex;align-items:center;justify-content:space-between}.logo{font-size:28px;font-weight:900;color:var(--b)}.logo span{color:var(--d)}
nav{display:flex;gap:22px;align-items:center}nav a{font-weight:700;color:var(--d);font-size:14px}
.btn{display:inline-block;border:0;border-radius:10px;padding:12px 18px;font-weight:800;cursor:pointer}.blue{background:var(--b);color:#fff}.green{background:var(--g);color:#fff}.outline{border:1px solid var(--line);background:#fff;color:var(--d)}
.hero{padding:75px 0 60px;background:linear-gradient(135deg,#eff6ff,#fff)}.hero-grid{display:grid;grid-template-columns:1.15fr .85fr;gap:40px;align-items:center}
.badge{display:inline-block;background:#dbeafe;color:#1d4ed8;padding:6px 11px;border-radius:20px;font-weight:800;font-size:13px}
h1{font-size:clamp(40px,6vw,64px);line-height:1.05;letter-spacing:-2px;margin:18px 0}.hero h1 span{color:var(--b)}.hero p{font-size:18px;color:var(--m)}
.actions{display:flex;gap:10px;flex-wrap:wrap;margin:25px 0}.hero-card,.card,form,.contact{background:#fff;border:1px solid var(--line);border-radius:18px;padding:24px}
.hero-card{box-shadow:0 15px 40px #0f172a12}.quick{display:grid;grid-template-columns:1fr 1fr;gap:12px}.quick div{border:1px solid var(--line);padding:14px;border-radius:12px}.quick b{display:block;color:var(--b);font-size:21px}
section{padding:68px 0}.title{text-align:center;margin-bottom:32px}.title h2{font-size:34px;margin:0 0 7px}.title p{color:var(--m)}
.search{display:flex;gap:10px;max-width:760px;margin:0 auto 25px}.search input{flex:1}
input,select,textarea{width:100%;padding:13px;border:1px solid var(--line);border-radius:10px;font:inherit;margin:0 0 14px}textarea{min-height:100px}
.grid{display:grid;grid-template-columns:repeat(3,1fr);gap:17px}.card h3{margin:0 0 7px}.card p{color:var(--m);font-size:14px}.tag{display:inline-block;margin-top:9px;padding:4px 8px;border-radius:6px;background:#eff6ff;color:#1d4ed8;font-size:12px;font-weight:800}
.process{display:grid;grid-template-columns:repeat(4,1fr);gap:18px}.step{text-align:center}.num{width:46px;height:46px;border-radius:50%;background:var(--b);color:#fff;display:grid;place-items:center;margin:auto auto 12px;font-weight:900}
.formgrid{display:grid;grid-template-columns:.8fr 1.2fr;gap:28px}.contact{background:var(--d);color:#fff}.contact p{color:#cbd5e1}
.row{display:grid;grid-template-columns:1fr 1fr;gap:12px}label{font-size:13px;font-weight:800;display:block;margin-bottom:5px}
footer{background:#0b1220;color:#cbd5e1;padding:32px 0}.foot{display:flex;justify-content:space-between;gap:20px;flex-wrap:wrap}.small{font-size:13px;color:#94a3b8}
@media(max-width:800px){nav{display:none}.hero-grid,.formgrid{grid-template-columns:1fr}.grid{grid-template-columns:1fr 1fr}.process{grid-template-columns:1fr 1fr}}
@media(max-width:560px){.grid,.process,.row{grid-template-columns:1fr}.search{flex-direction:column}}

/* AdmiGo Professional Upgrade */
:root{--b:#155eef;--b2:#0b4fd7;--g:#12a150;--d:#0b1220;--m:#64748b;--bg:#f5f8ff;--line:#e5eaf2}
body{background:var(--bg)}
header{backdrop-filter:blur(12px);background:rgba(255,255,255,.94)}
.logo{letter-spacing:-1px}
.hero{position:relative;overflow:hidden;padding:88px 0 72px;background:radial-gradient(circle at 85% 20%,#dbeafe 0,transparent 34%),linear-gradient(135deg,#eef5ff,#fff 62%,#f4fff8)}
.hero:before{content:"";position:absolute;width:420px;height:420px;border-radius:50%;right:-160px;bottom:-230px;background:#dbeafe;opacity:.55}
.hero-grid{position:relative}
.hero h1{max-width:760px}
.hero p{max-width:680px}
.btn{transition:transform .18s ease,box-shadow .18s ease}
.btn:hover{transform:translateY(-2px);box-shadow:0 8px 20px #0f172a18}
.hero-card{border:0;box-shadow:0 20px 55px #0f172a18}
.quick div{background:linear-gradient(180deg,#fff,#f8fbff);transition:.2s}
.quick div:hover{transform:translateY(-3px);box-shadow:0 10px 25px #0f172a12}
.card{transition:.2s;border-radius:16px;box-shadow:0 3px 15px #0f172a08}
.card:hover{transform:translateY(-4px);box-shadow:0 12px 30px #0f172a12;border-color:#cbdcfb}
.search input{box-shadow:0 4px 18px #0f172a0b}
form{box-shadow:0 12px 35px #0f172a0b}
.contact{background:linear-gradient(145deg,#0b1220,#14233f)}
.tag{border-radius:999px}
@media(max-width:560px){
 .hero{padding:58px 0 48px}
 .hero h1{font-size:42px;letter-spacing:-1.4px}
 .actions .btn{width:100%;text-align:center}
 .hero-card{padding:18px}
 .title h2{font-size:29px}
 section{padding:52px 0}
}
</style>
</head>
<body>
<header><div class="wrap nav"><a class="logo" href="#">Admi<span>Go</span></a><nav><a href="#courses">Courses</a><a href="#process">How It Works</a><a href="#enquiry">Enquiry</a><a class="btn green" href="https://wa.me/919006616519?text=Hello%20AdmiGo%2C%20I%20need%20admission%20guidance" target="_blank">WhatsApp</a></nav></div></header>

<section class="hero"><div class="wrap hero-grid"><div><span class="badge">Admissions Across India</span><h1>Find the Right <span>Course & College</span> with AdmiGo</h1><p>Admission counselling for Nursing, Pharmacy, Paramedical, Engineering, Computer, Management, Commerce, ITI and other career-focused courses.</p><div class="actions"><a class="btn blue" href="#enquiry">Get Admission Guidance</a><a class="btn green" href="https://wa.me/919006616519?text=Hello%20AdmiGo%2C%20I%20want%20help%20with%20college%20admission" target="_blank">Chat on WhatsApp</a></div><p>By Nitish Kumar • <a href="tel:+919006616519">9006616519</a></p></div><div class="hero-card"><h2>Why AdmiGo?</h2><div class="quick"><div><b>All India</b>College options</div><div><b>1:1</b>Admission guidance</div><div><b>Many</b>Course categories</div><div><b>Direct</b>WhatsApp support</div></div></div></div></section>


<section style="padding:18px 0;background:#fff;border-bottom:1px solid var(--line)">
<div class="wrap" style="display:flex;justify-content:center;gap:28px;flex-wrap:wrap;color:#475569;font-weight:800;font-size:14px">
<span>✓ Course Guidance</span><span>✓ College Options</span><span>✓ Fee & Eligibility Discussion</span><span>✓ WhatsApp Support</span>
</div></section>
<section id="courses"><div class="wrap"><div class="title"><h2>Courses & Admission Options</h2><p>Search a course and send your enquiry.</p></div><div class="search"><input id="q" placeholder="Search Nursing, BCA, Pharmacy, Engineering..." oninput="filterCourses()"><button class="btn blue" onclick="filterCourses()">Search</button></div>
<div class="grid" id="grid">
<div class="card"><h3>B.Sc Nursing</h3><p>Undergraduate nursing admission guidance.</p><span class="tag">Nursing</span></div>
<div class="card"><h3>GNM Nursing</h3><p>General Nursing and Midwifery options.</p><span class="tag">Nursing</span></div>
<div class="card"><h3>ANM</h3><p>Auxiliary Nursing and Midwifery options.</p><span class="tag">Nursing</span></div>
<div class="card"><h3>B.Pharm</h3><p>Bachelor of Pharmacy admission guidance.</p><span class="tag">Pharmacy</span></div>
<div class="card"><h3>D.Pharm</h3><p>Diploma in Pharmacy options.</p><span class="tag">Pharmacy</span></div>
<div class="card"><h3>DMLT</h3><p>Medical Laboratory Technology options.</p><span class="tag">Paramedical</span></div>
<div class="card"><h3>B.Sc Medical Lab Technology</h3><p>Laboratory technology degree options.</p><span class="tag">Paramedical</span></div>
<div class="card"><h3>Radiology / Imaging</h3><p>Radiology and medical imaging courses.</p><span class="tag">Paramedical</span></div>
<div class="card"><h3>Operation Theatre Technology</h3><p>OT technician and allied health courses.</p><span class="tag">Paramedical</span></div>
<div class="card"><h3>Physiotherapy</h3><p>Physiotherapy degree and related options.</p><span class="tag">Paramedical</span></div>
<div class="card"><h3>Optometry</h3><p>Optometry and eye-care programmes.</p><span class="tag">Paramedical</span></div>
<div class="card"><h3>Emergency / Critical Care</h3><p>Allied health and emergency-care courses.</p><span class="tag">Paramedical</span></div>
<div class="card"><h3>B.Tech / Engineering</h3><p>Engineering branches and college guidance.</p><span class="tag">Engineering</span></div>
<div class="card"><h3>BCA</h3><p>Bachelor of Computer Applications.</p><span class="tag">Computer</span></div>
<div class="card"><h3>MCA</h3><p>Master of Computer Applications.</p><span class="tag">Computer</span></div>
<div class="card"><h3>BBA</h3><p>Business Administration options.</p><span class="tag">Management</span></div>
<div class="card"><h3>MBA</h3><p>Management postgraduate options.</p><span class="tag">Management</span></div>
<div class="card"><h3>B.Com</h3><p>Commerce degree options.</p><span class="tag">Commerce</span></div>
<div class="card"><h3>M.Com</h3><p>Commerce postgraduate options.</p><span class="tag">Commerce</span></div>
<div class="card"><h3>BA / MA</h3><p>Arts and humanities options.</p><span class="tag">Arts</span></div>
<div class="card"><h3>B.Sc / M.Sc</h3><p>Science degree and postgraduate options.</p><span class="tag">Science</span></div>
<div class="card"><h3>Hotel Management</h3><p>Hospitality and hotel management courses.</p><span class="tag">Hospitality</span></div>
<div class="card"><h3>LLB / Law</h3><p>Law programme admission guidance.</p><span class="tag">Law</span></div>
<div class="card"><h3>ITI Courses</h3><p>Technical trades and ITI options.</p><span class="tag">ITI</span></div>
<div class="card"><h3>Diploma Courses</h3><p>Technical and career-focused diplomas.</p><span class="tag">Diploma</span></div>
<div class="card"><h3>Other Courses</h3><p>Tell us your preferred course.</p><span class="tag">Other</span></div>
</div></div></section>

<section id="process" style="background:#fff"><div class="wrap"><div class="title"><h2>How AdmiGo Works</h2><p>Simple admission guidance in four steps.</p></div><div class="process"><div class="step"><div class="num">1</div><h3>Send Enquiry</h3><p>Share your course and qualification.</p></div><div class="step"><div class="num">2</div><h3>Get Options</h3><p>Discuss suitable colleges and courses.</p></div><div class="step"><div class="num">3</div><h3>Compare</h3><p>Compare eligibility, fees and details.</p></div><div class="step"><div class="num">4</div><h3>Apply</h3><p>Get guidance on next admission steps.</p></div></div></div></section>

<section id="enquiry"><div class="wrap formgrid"><div class="contact"><h2>Start Your Admission Enquiry</h2><p>Fill the form. It will open WhatsApp with your enquiry details.</p><a class="btn green" href="tel:+919006616519">Call 9006616519</a><p>AdmiGo • By Nitish Kumar</p></div><form id="form"><h2>Student Enquiry Form</h2><div class="row"><div><label>Name *</label><input id="name" required placeholder="Student name"></div><div><label>Mobile *</label><input id="phone" required type="tel" placeholder="10-digit number"></div></div><div class="row"><div><label>Course *</label><select id="course" required><option value="">Select</option><option>B.Sc Nursing</option><option>GNM</option><option>ANM</option><option>B.Pharm</option><option>D.Pharm</option><option>DMLT</option><option>Radiology / Imaging</option><option>Operation Theatre Technology</option><option>Physiotherapy</option><option>B.Tech / Engineering</option><option>BCA</option><option>MCA</option><option>BBA</option><option>MBA</option><option>B.Com</option><option>M.Com</option><option>BA / MA</option><option>B.Sc / M.Sc</option><option>Hotel Management</option><option>LLB / Law</option><option>ITI</option><option>Diploma</option><option>Other</option></select></div><div><label>Preferred State/City</label><input id="state" placeholder="Punjab, Bihar, Chandigarh..."></div></div><label>Qualification</label><input id="qual" placeholder="12th PCB, PCM, Graduation..."><label>Message</label><textarea id="msg" placeholder="Marks, budget, preferred college..."></textarea><button class="btn blue" style="width:100%" type="submit">Send Enquiry on WhatsApp</button><p style="font-size:12px;color:#64748b">Admission/seat availability is subject to confirmation by the respective institution.</p></form></div></section>

<footer><div class="wrap foot"><div><b style="font-size:24px;color:#fff">AdmiGo</b><div class="small">College & Course Admission Counselling • India</div></div><div class="small">© <span id="year"></span> AdmiGo • By Nitish Kumar • 9006616519</div></div></footer>
<script>
function filterCourses(){let q=document.getElementById('q').value.toLowerCase();document.querySelectorAll('#grid .card').forEach(x=>x.style.display=x.innerText.toLowerCase().includes(q)?'block':'none')}
document.getElementById('form').addEventListener('submit',function(e){e.preventDefault();let t=`Hello AdmiGo, I want admission guidance.%0A%0AStudent Name: ${name.value}%0AMobile: ${phone.value}%0ACourse: ${course.value}%0APreferred State/City: ${state.value||'Not specified'}%0AQualification: ${qual.value||'Not specified'}%0AMessage: ${msg.value||'None'}`;window.open('https://wa.me/919006616519?text='+t,'_blank')});
document.getElementById('year').textContent=new Date().getFullYear();
</script>

<a href="https://wa.me/919006616519?text=Hello%20AdmiGo%2C%20I%20need%20admission%20guidance"
target="_blank" aria-label="Chat with AdmiGo on WhatsApp"
style="position:fixed;right:18px;bottom:18px;z-index:20;background:#16a34a;color:#fff;border-radius:999px;padding:14px 18px;font-weight:900;box-shadow:0 10px 30px #0002">WhatsApp</a>
</body></html>